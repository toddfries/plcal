use strict; use warnings; use Test::More;
use FindBin; use lib "$FindBin::Bin/../lib";
use O365GCal::ICS;
sub slurp { open my $f, '<:raw', "$FindBin::Bin/fixtures/msgs/$_[0]" or die; local $/; <$f> }
is(O365GCal::ICS::iana('Central Standard Time'), 'America/Chicago', 'windows tz');
is(O365GCal::ICS::iana('(UTC-05:00) Eastern Time (US & Canada)'), 'America/New_York', 'outlook label tz');
is(O365GCal::ICS::iana('America/Denver'), 'America/Denver', 'iana passthrough');
is(O365GCal::ICS::iana('/mozilla.org/20050126_1/Europe/Paris'), 'Europe/Paris', 'mozilla tzid');
is(O365GCal::ICS::iana('Nowhere Time', 'America/Chicago'), 'America/Chicago', 'unknown -> default');
my @p = O365GCal::ICS::calendar_parts(slurp('01-series.eml'));
is(scalar @p, 1, 'base64 nested multipart part found');
my $c = O365GCal::ICS::parse($p[0]);
is($c->{method}, 'REQUEST');
is(scalar @{ $c->{events} }, 1, 'one VEVENT (VALARM not separate)');
my $ev = $c->{events}[0];
unlike($ev->{DESCRIPTION}{value} // '', qr/alarm/, 'VALARM props did not leak');
my $g = O365GCal::ICS::to_google($ev);
is_deeply($g->{start}, { dateTime => '2026-11-02T09:00:00', timeZone => 'America/Chicago' }, 'start w/ tz');
is($g->{location}, 'Room 1, Building A', 'unescaped location');
is_deeply($g->{recurrence}, ['RRULE:FREQ=WEEKLY;COUNT=10;BYDAY=MO'], 'rrule');
my $g2 = O365GCal::ICS::to_google($ev, exdates => [{ dateTime => '2026-11-16T09:00:00', timeZone => 'America/Chicago' }]);
is($g2->{recurrence}[1], 'EXDATE;TZID=America/Chicago:20261116T090000', 'exdate');
@p = O365GCal::ICS::calendar_parts(slurp('02-moved.eml'));
$ev = O365GCal::ICS::parse($p[0])->{events}[0];
is(O365GCal::ICS::recid_str($ev), '2026-11-09T09:00:00|America/Chicago', 'QP + recurrence-id');
ok(!O365GCal::ICS::to_google($ev)->{recurrence}, 'override has no recurrence');
@p = O365GCal::ICS::calendar_parts(slurp('05-forwarded.eml'));
is(scalar @p, 1, 'forwarded message/rfc822 part');
my @e = @{ O365GCal::ICS::parse($p[0])->{events} };
is_deeply(O365GCal::ICS::to_google($e[0])->{end}, { date => '2026-12-02' }, 'all-day default 1 day');
is_deeply(O365GCal::ICS::to_google($e[1])->{end}, { dateTime => '2026-12-03T14:45:00', timeZone => 'America/New_York' }, 'DURATION');
is(O365GCal::ICS::to_google($e[0], detail => 'busy')->{summary}, 'Busy (work)', 'busy mode');
done_testing;
